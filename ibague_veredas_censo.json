(async function loadCensoVeredas(){
  try{
    let data=null;
    for(const u of (CONFIG.censoVeredasUrls||[])){
      try{ const r=await fetch(u,{cache:'no-store'}); if(!r.ok) throw 0; data=await r.json(); Diag.log(`Censo veredas: ${u} ✔`); break; }
      catch(_){ Diag.log(`Censo veredas: ${u} — 404`, false); }
    }
    if(!data){ const el=document.getElementById('censoVeredas'); if(el){ data=JSON.parse(el.textContent); Diag.log('Censo veredas (embebido) ✔'); } }
    if(!data) return;

    const pick=(obj, arr)=>{ for(const k of arr) if(obj && Object.hasOwn(obj,k)) return k; for(const k in obj||{}) if(arr.some(a=>k.toLowerCase().includes(a.toLowerCase()))) return k; return null; };
    const sample = Array.isArray(data)? data[0] : data;
    const nameKey = pick(sample, CONFIG.nameKeysVereda) || 'VEREDA';
    const popKey  = pick(sample, CONFIG.popKeys)        || 'POB_TOTAL';

    const norm=s=>s?String(s).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^\w\s]/g,'').replace(/\s+/g,' ').trim():null;
    const M = new Map();
    (Array.isArray(data)? data : Object.values(data)).forEach(row=>{
      const name = norm(row[nameKey]);
      const val  = Number(String(row[popKey]).replace(/[^0-9.]/g,''));
      if(name && Number.isFinite(val)) M.set(name,val);
    });
    cache.censusVeredasByName = M;
    Diag.log(`Censo veredas ✔ (${M.size})`);
  }catch(e){ Diag.log("Censo veredas — "+e.message, false); }
})();

