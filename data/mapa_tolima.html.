// Comunas (unir por nombre):
const [geoComunas, censoComunas] = await Promise.all([
  fetch('./data/ibague_urbano.geojson').then(r=>r.json()),
  fetch('./data/comunas_ibague.json').then(r=>r.json())
]);
const idxCom = new Map(censoComunas.map(d => [(d.nombre||'').trim().toUpperCase(), d.pob_2018]));
L.geoJSON(geoComunas, {
  style:{color:'#0a6dc2',weight:1,fillOpacity:.20},
  onEachFeature:(f,lyr)=>{
    const n = ((f.properties?.nombre||f.properties?.NOMBRE||'')+'').trim().toUpperCase();
    const pob = idxCom.get(n) ?? 's/d';
    lyr.bindPopup(`<b>Comuna:</b> ${n}<br>Población 2018: <b>${pob}</b>`);
  }
}).addTo(map);

